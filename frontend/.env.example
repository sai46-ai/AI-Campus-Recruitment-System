# ==============================================================================
# AI CAMPUS RECRUITMENT SYSTEM — FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env in the frontend directory:
#   cp .env.example .env
#
# NOTE: In Vite, only variables prefixed with VITE_ are exposed to the client bundle.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API URL (Required)
# ------------------------------------------------------------------------------
# Target URL for Express API calls.
# - In local development: http://localhost:5000/api/v1
# - In Docker / Nginx reverse proxy: /api/v1 (relative path routes through Nginx)
# - In separate cloud hosting (e.g. Render Static Site + Render Web Service): https://ai-campus-backend.onrender.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# ------------------------------------------------------------------------------
# 2. RUNTIME ENVIRONMENT (Optional)
# ------------------------------------------------------------------------------
VITE_ENV=development
VITE_DEBUG=false
