# ========================================
# AI Service (Python) Environment Configuration
# ========================================
# Copy this file to .env in the ai-service directory

# FastAPI Server Configuration
PORT=8000
HOST=0.0.0.0

# Environment
DEBUG=true
ENV=development

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8000

# NLP Model Configuration
# The spaCy model to use for NLP processing
SPACY_MODEL=en_core_web_sm
MODEL_CACHE_DIR=./models

# Logging Configuration
LOG_LEVEL=INFO

# Performance Settings
# Maximum file size for resume uploads (in MB)
MAX_FILE_SIZE=5
# Request timeout in seconds
REQUEST_TIMEOUT=30
