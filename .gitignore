# Node dependencies
node_modules/
**/node_modules/
.pnp/
.pnp.js

# Builds & compiled output
build/
**/build/
dist/
**/dist/
coverage/
**/coverage/

# Logs & debugging
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files & secrets (Strict: never track secrets, keep examples)
.env
.env.*
.env.local
.env.*.local
**/.env
**/.env.*
!**/.env.example

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/

# OS & Editor files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.vscode/
.idea/
*.swp
*.swo

# Application data & resume uploads (preserve folder structure via .gitkeep, never store files)
uploads/
**/uploads/*
!**/uploads/.gitkeep
!**/uploads/resumes/.gitkeep
backend/uploads/*
backend/logs/

# Test & runtime artifacts
.playwright-mcp/
**/.playwright-mcp/
security-audit/
scratch/

# Upgrade & audit reports
ProjectUpgradeReports/
**/ProjectUpgradeReports/
