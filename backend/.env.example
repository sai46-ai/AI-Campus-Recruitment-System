# ==============================================================================
# AI CAMPUS RECRUITMENT SYSTEM — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env in the backend directory:
#   cp .env.example .env
#
# NOTE: In production (NODE_ENV=production), all authentication secrets
# (JWT_SECRET, JWT_REFRESH_SECRET, CSRF_SECRET) MUST be set and >= 32 characters.
# Generate secure random secrets using: openssl rand -base64 48
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION (Required)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Allowed frontend origin(s) for CORS. In production, comma-separate multiple origins.
# Example: CLIENT_URL=https://mycampus.edu,https://recruitment.mycampus.edu,https://*.vercel.app
CLIENT_URL=http://localhost:5173

# Optional: Enable dynamic CORS allowance for *.vercel.app preview branches
ALLOW_VERCEL_PREVIEWS=true

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (Required in Production)
# ------------------------------------------------------------------------------
# In development, if unreachable, automatically falls back to an in-memory MongoDB instance.
# In production, a persistent MongoDB connection string is required (Atlas, local, or Docker).
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/ai_campus_recruitment?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ai_campus_recruitment
MONGODB_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & CRYPTOGRAPHIC SECRETS (Required)
# ------------------------------------------------------------------------------
# All secrets MUST be unique and at least 32 characters long.
# Generate in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super_secret_jwt_access_key_change_in_production_2026
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_2026
JWT_REFRESH_EXPIRES_IN=7d

CSRF_SECRET=super_secret_csrf_key_change_in_production_2026

# ------------------------------------------------------------------------------
# 4. RESUME / DEMONSTRATION FLAGS (Optional, Recommended for Portfolio Demos)
# ------------------------------------------------------------------------------
# Automatically initializes 4 verified demo accounts on startup (admin, student, recruiter, placement).
# In production, disabled by default unless explicitly set to true.
ALLOW_PRODUCTION_SEED=true

# If true and SMTP is unconfigured, logs new registration OTPs to console instead of failing.
# Essential for testing live registration in production without setting up an email service.
ALLOW_DEV_OTP=true

# ------------------------------------------------------------------------------
# 5. AI ENGINE CONFIGURATION (Optional - Has Full Local Fallback)
# ------------------------------------------------------------------------------
# Python FastAPI AI microservice URL (e.g., Render Private Service internal DNS or localhost:8000).
# If omitted or unreachable, the system automatically falls back to Gemini API or built-in heuristic NLP.
AI_SERVICE_URL=http://localhost:8000

# Google Gemini API key for ATS analysis and candidate-job matching.
# If omitted or invalid, the backend automatically uses its built-in deterministic
# heuristic NLP parser and skill matching engine.
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# If true in production, fails requests if Gemini API fails rather than using heuristic fallback.
REQUIRE_GEMINI=false

# ------------------------------------------------------------------------------
# 6. CACHING & DISTRIBUTED SESSIONS (Optional)
# ------------------------------------------------------------------------------
# Redis connection URL. Leave blank or comment out to run in standalone mode.
# Sessions are stored in MongoDB; rate limiting runs in-memory.
REDIS_URL=
REDIS_REQUIRED=false

# ------------------------------------------------------------------------------
# 7. GOOGLE OAUTH LOGIN (Optional)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID. Required only if using Google Sign-In endpoint.
# The primary web UI uses collegiate email/password authentication.
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 8. FILE STORAGE CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
# Physical directory where uploaded student resumes (PDF/DOCX) are stored.
# Defaults to ./uploads relative to backend directory.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760 # 10MB in bytes

# ------------------------------------------------------------------------------
# 9. EMAIL NOTIFICATIONS & OTP DELIVERY (Optional)
# ------------------------------------------------------------------------------
# SMTP credentials for sending registration OTP verification emails.
# Leave commented out if using ALLOW_DEV_OTP=true.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
# FROM_EMAIL=noreply@campus.edu
# FROM_NAME=AI Campus Recruitment System
