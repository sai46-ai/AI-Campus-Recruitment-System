# ==============================================================================
# AI CAMPUS RECRUITMENT SYSTEM — ROOT DOCKER COMPOSE CONFIGURATION
# ==============================================================================
# Copy this file to .env in the project root before running docker compose:
#   cp .env.example .env
#   docker compose up -d
#
# Default access points:
#   Frontend SPA:          http://localhost:5173 (or port 80 via Nginx)
#   Backend API:           http://localhost:5000/api/v1
#   API Health:            http://localhost:5000/api/v1/health
#   AI Service (FastAPI):  http://localhost:8000 (OpenAPI docs at /docs)
#   MongoDB:               localhost:27017 (data persisted in mongodb_data volume)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# In production, these MUST be unique strings with at least 32 characters.
# Generate strong secrets with: openssl rand -base64 48
JWT_SECRET=super_secret_jwt_access_key_min_32_characters_long_2026
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_min_32_characters_long_2026
CSRF_SECRET=super_secret_csrf_key_min_32_characters_long_2026

# ------------------------------------------------------------------------------
# 3. DEMO & RESUME PRESENTATION FLAGS
# ------------------------------------------------------------------------------
# Automatically seeds default accounts: student@campus.edu, recruiter@campus.edu, etc.
ALLOW_PRODUCTION_SEED=true

# Logs OTP to server console if SMTP is not configured, enabling live registration demo.
ALLOW_DEV_OTP=true

# ------------------------------------------------------------------------------
# 4. OPTIONAL EXTERNAL SERVICES
# ------------------------------------------------------------------------------
# Google Gemini API Key for ATS analysis (system falls back to local NLP if omitted).
GEMINI_API_KEY=

# Google OAuth Client ID (optional; UI uses email/password auth).
GOOGLE_CLIENT_ID=

# External SMTP credentials (optional; leave blank if using ALLOW_DEV_OTP=true).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
# FROM_EMAIL=noreply@campus.edu

